[Unit]
Description=TrueCountLab blackjack count trainer
# Keep retrying at boot until the network address in .env is up.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/blackjack
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=5
# HOST and PORT come from ~/blackjack/.env on the server (kept out of git).
# Without it the server listens on 127.0.0.1:3040.
EnvironmentFile=-%h/blackjack/.env
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
